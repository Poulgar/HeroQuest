@model HeroQuest.ViewModels.EquipmentsArtifactsViewModel
@{
    ViewData["Title"] = "Equipo y artefactos";
    string ShortIndexName(string name, int limit = 25) => name.Length <= limit ? name : name[..(limit - 1)] + "…";
}

<section class="catalog-page page-shell">
    <div class="page-heading">
        <p class="eyebrow">EL COMPENDIO</p>
        <h1>Equipo y <em>artefactos</em></h1>
        <p>Armas, armaduras, artefactos mágicos y reliquias del mundo de HeroQuest.</p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-note"><span aria-hidden="true">⚜</span><p>Aún no hay equipamiento o artefactos registrados.</p></div>
    }
    else
    {
        <div class="catalog-layout">
            <aside class="catalog-list equipment-list" aria-label="Índice de equipo y artefactos">
                <p class="list-caption">ÍNDICE <span>@Model.Items.Count OBJETOS</span></p>
                <div class="equipment-category-tabs" role="group" aria-label="Filtrar categoría">
                    <button type="button" class="equipment-category-button active" data-equipment-category="Equipment" aria-pressed="true">Equipos</button>
                    <button type="button" class="equipment-category-button" data-equipment-category="Artifact" aria-pressed="false">Artefactos</button>
                </div>
                <div class="index-tools">
                    <label>Buscar <input class="index-search" type="search" placeholder="Nombre o tipo…" /></label>
                    <label>Ordenar <select class="index-sort"><option value="name-asc">A-Z</option><option value="name-desc">Z-A</option><option value="price-asc">Precio: menor</option><option value="price-desc">Precio: mayor</option><option value="appears">Expansión</option></select></label>
                </div>
                <div class="catalog-scroll" data-index-list>
                @foreach (var item in Model.Items)
                {
                    <a class="catalog-row @(Model.SelectedItem?.Id == item.Id ? "selected" : "")"
                       data-select-record="@item.Id" data-name="@item.Name" data-category="@item.Category" data-search="@item.Name @item.Type @item.Description" data-price="@item.Price" data-appears="@item.Appears.DisplayName()" data-id="@item.Id"
                       asp-controller="Archive" asp-action="Equipment" asp-route-id="@item.Id" aria-current="@(Model.SelectedItem?.Id == item.Id ? "page" : null)">
                        <span class="row-demo-image"><img src="@(item.Category.Equals("Artifact", StringComparison.OrdinalIgnoreCase) ? Url.Content("~/images/heroquest/artifact-relic.svg") : Url.Content("~/images/heroquest/equipment-sword.svg"))" alt="" /></span>
                        <span class="row-main"><strong>@ShortIndexName(item.Name)</strong><small>@item.Category • @item.Type</small></span>
                        <span class="row-chevron" aria-hidden="true">›</span>
                    </a>
                }
                </div>
            </aside>

            <div class="detail-host" data-detail-host>
                @if (Model.SelectedItem is { } selectedItem)
                {
                    @await Html.PartialAsync("~/Views/Shared/_EquipmentDetailCard.cshtml", selectedItem)
                }
            </div>
        </div>

        @foreach (var item in Model.Items)
        {
            <template data-detail-template="@item.Id">@await Html.PartialAsync("~/Views/Shared/_EquipmentDetailCard.cshtml", item)</template>
        }
    }
</section>

