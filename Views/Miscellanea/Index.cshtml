@model HeroQuest.ViewModels.MiscellaneaViewModel
@{
    ViewData["Title"] = "Miscelánea";
    string ShortIndexName(string name, int limit = 25) => name.Length <= limit ? name : name[..(limit - 1)] + "…";
}

<section class="catalog-page page-shell">
    <div class="page-heading">
        <p class="eyebrow">EL COMPENDIO</p>
        <h1>La <em>miscelánea</em></h1>
        <p>Objetos, tesoros y consumibles del compendio de aventuras.</p>
    </div>

    @if (Model.Entries.Count == 0)
    {
        <div class="empty-note"><span aria-hidden="true">⚜</span><p>Aún no hay objetos de miscelánea registrados.</p></div>
    }
    else
    {
        <div class="catalog-layout">
            <aside class="catalog-list" aria-label="Índice de miscelánea">
                <p class="list-caption">ÍNDICE <span>@Model.Entries.Count OBJETOS</span></p>
                <div class="index-tools">
                    <label>Buscar <input class="index-search" type="search" placeholder="Nombre…" /></label>
                    <label>Ordenar <select class="index-sort"><option value="name-asc">A-Z</option><option value="name-desc">Z-A</option><option value="price-asc">Precio: menor</option><option value="price-desc">Precio: mayor</option><option value="appears">Expansión</option></select></label>
                </div>
                <div class="catalog-scroll" data-index-list>
                @foreach (var entry in Model.Entries)
                {
                    <a class="catalog-row @(Model.SelectedEntry?.Id == entry.Id ? "selected" : "")"
                       data-select-record="@entry.Id" data-name="@entry.Name" data-search="@entry.Name" data-price="@entry.Price" data-appears="@entry.Appears.DisplayName()" data-id="@entry.Id"
                       asp-controller="Archive" asp-action="Miscellanea" asp-route-id="@entry.Id" aria-current="@(Model.SelectedEntry?.Id == entry.Id ? "page" : null)">
                        <span class="index-symbol" aria-hidden="true">
                            <svg viewBox="0 0 32 32"><path d="M11 3h10M13 3v7l-6 13c-1 3 1 5 4 5h10c3 0 5-2 4-5l-6-13V3M10 20h12M12 16h8" /></svg>
                        </span>
                        <span class="row-main"><strong>@ShortIndexName(entry.Name)</strong><small>@(entry.Price > 0 ? $"{entry.Price} mo" : "Sin precio")</small></span>
                        <span class="row-chevron" aria-hidden="true">›</span>
                    </a>
                }
                </div>
            </aside>

            <div class="detail-host" data-detail-host>
                @if (Model.SelectedEntry is { } selectedEntry)
                {
                    @await Html.PartialAsync("~/Views/Shared/_MiscellaneaDetailCard.cshtml", selectedEntry)
                }
            </div>
        </div>

        @foreach (var entry in Model.Entries)
        {
            <template data-detail-template="@entry.Id">@await Html.PartialAsync("~/Views/Shared/_MiscellaneaDetailCard.cshtml", entry)</template>
        }
    }
</section>


