@model HeroQuest.ViewModels.HeroQuestIndexViewModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="home-hero page-shell">
    <div class="home-copy">
        <p class="eyebrow">EL LIBRO DE LAS AVENTURAS</p>
        <h1>Que comiencen<br /><em>las leyendas.</em></h1>
        <p class="intro-copy">Consulta los héroes que desafían la oscuridad y las criaturas que aguardan en las mazmorras.</p>
        <div class="home-actions">
            <a class="button button-primary" asp-controller="Heroes" asp-action="Index">Abrir el registro de héroes</a>
            <a class="text-link" asp-controller="Monsters" asp-action="Index">Ver las criaturas <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-counts">
            <div><strong>@Model.HeroesCount</strong><span>héroes registrados</span></div>
            <div><strong>@Model.MonstersCount</strong><span>criaturas catalogadas</span></div>
            <div><strong>@Model.EquipmentCount</strong><span>equipos y artefactos</span></div>
            <div><strong>@Model.ModifierCount</strong><span>objetos y modificadores</span></div>
            <div><strong>@Model.MonsterAbilityCount</strong><span>habilidades de monstruo</span></div>
        </div>
    </div>
    <div class="home-art-frame">
        <img src="~/images/heroquest/heroquest-seal.svg" alt="Emblema heráldico de HeroQuest" />
        <span class="art-caption">TOMO I · EL REINO</span>
    </div>
</section>

<section class="home-shelves page-shell" aria-label="Secciones del compendio">
    <a class="shelf-card" asp-controller="Heroes" asp-action="Index">
        <span class="shelf-number">I</span><span class="shelf-label">Personajes</span>
        <h2>Los héroes</h2><p>Conoce sus atributos, equipo y relatos.</p><span class="shelf-arrow" aria-hidden="true">↗</span>
    </a>
    <a class="shelf-card" asp-controller="Monsters" asp-action="Index">
        <span class="shelf-number">II</span><span class="shelf-label">Bestiario</span>
        <h2>Las criaturas</h2><p>Descubre qué se oculta en las sombras.</p><span class="shelf-arrow" aria-hidden="true">↗</span>
    </a>
    <a class="shelf-card shelf-card-muted" asp-controller="Archive" asp-action="Equipment">
        <span class="shelf-number">III</span><span class="shelf-label">Armería</span>
        <h2>Equipo y artefactos</h2><p>El catálogo de objetos se abrirá próximamente.</p><span class="shelf-arrow" aria-hidden="true">↗</span>
    </a>
    <a class="shelf-card shelf-card-muted" asp-controller="Archive" asp-action="Modifiers">
        <span class="shelf-number">IV</span><span class="shelf-label">Reglas</span>
        <h2>Modificadores</h2><p>Los efectos y modificadores se añadirán más adelante.</p><span class="shelf-arrow" aria-hidden="true">↗</span>
    </a>
</section>
