@model HeroQuest.ViewModels.MonsterCatalogViewModel
@{
    ViewData["Title"] = "Monstruos";
    string ShortIndexName(string name, int limit = 25) => name.Length <= limit ? name : name[..(limit - 1)] + "…";
}

<section class="catalog-page page-shell">
    <div class="page-heading">
        <p class="eyebrow">EL BESTIARIO</p>
        <h1>Criaturas de la <em>mazmorra</em></h1>
        <p>Selecciona una criatura para consultar sus atributos y habilidades.</p>
    </div>

    @if (Model.Monsters.Count == 0)
    {
        <div class="empty-note"><span aria-hidden="true">⚜</span><p>Aún no hay criaturas en el bestiario.</p></div>
    }
    else
    {
        <div class="catalog-layout">
            <aside class="catalog-list" aria-label="Lista de monstruos">
                <p class="list-caption">ÍNDICE <span>@Model.Monsters.Count CRIATURAS</span></p>
                <div class="index-tools">
                    <label>Buscar <input class="index-search" type="search" placeholder="Nombre o habilidad…" /></label>
                    <label>Facción
                        <select class="faction-filter">
                            <option value="">Todas las facciones</option>
                            @foreach (var faction in Model.Monsters.Select(monster => monster.Faction).Where(faction => !string.IsNullOrWhiteSpace(faction)).Distinct().OrderBy(faction => faction, StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("es-ES"), true)))
                            {
                            <option value="@faction">@faction</option>
                            }
                        </select>
                    </label>
                    <label>Ordenar <select class="index-sort"><option value="name-asc">A-Z</option><option value="name-desc">Z-A</option><option value="appears">Expansión</option></select></label>
                </div>
                <div class="catalog-scroll" data-index-list>
                @foreach (var monster in Model.Monsters)
                {
                    <a class="catalog-row @(Model.SelectedMonster?.Id == monster.Id ? "selected" : "")"
                       data-select-record="@monster.Id" data-name="@monster.Name" data-faction="@monster.Faction" data-search="@monster.Name @monster.Faction @monster.Ability" data-appears="@monster.Appears.DisplayName()" data-original="@(monster.Appears.HasFlag(HeroQuest.Models.TypeAppears.Original).ToString().ToLowerInvariant())" data-id="@monster.Id"
                       asp-controller="Monsters" asp-action="Index" asp-route-id="@monster.Id" aria-current="@(Model.SelectedMonster?.Id == monster.Id ? "page" : null)">
                        <span role="button" tabindex="0" class="faction-token faction-token-small lore-trigger hover-tooltip" style="--faction-color: @monster.Faction.FactionColor()" data-tooltip="@monster.Faction" data-lore-title="Facción: @monster.Faction" data-full-description="@monster.Faction.FactionLore()" aria-label="Consultar lore de la facción @monster.Faction">@monster.Faction.FactionSymbol()</span>
                        <span class="row-main">
                            <strong>@ShortIndexName(string.IsNullOrEmpty(monster.Name) ? monster.CharacterTypeClass : monster.Name)</strong>
                            <small class="row-stats">@monster.Hp HP · D@(monster.DicesMind) MND · D@(monster.DicesAttack) ATK · D@(monster.DicesDefend) DFC</small>
                        </span>
                        <span class="row-chevron" aria-hidden="true">›</span>
                    </a>
                }
                </div>
            </aside>

            <div class="detail-host" data-detail-host>
                @if (Model.SelectedMonster is { } monsterDetail)
                {
                    @await Html.PartialAsync("~/Views/Shared/_MonsterDetailCard.cshtml", new HeroQuest.ViewModels.MonsterDetailCardViewModel { Monster = monsterDetail, Abilities = Model.Abilities })
                }
            </div>
        </div>

        @foreach (var monster in Model.Monsters)
        {
            <template data-detail-template="@monster.Id">@await Html.PartialAsync("~/Views/Shared/_MonsterDetailCard.cshtml", new HeroQuest.ViewModels.MonsterDetailCardViewModel { Monster = monster, Abilities = Model.Abilities })</template>
        }
    }
</section>

<section class="ability-archive page-shell">
    <div class="ability-heading">
        <p class="eyebrow">SABER DEL BESTIARIO</p>
        <h2>Habilidades y hechizos del bestiario</h2>
        <p>Capacidades y conjuros registrados en el compendio, junto con las criaturas que los poseen.</p>
    </div>
    @if (Model.Abilities.Count == 0 && Model.SpellsOfTerror.Count == 0)
    {
        <div class="empty-note"><p>Aún no hay habilidades ni hechizos importados.</p></div>
    }
    else
    {
        var spanishComparer = StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("es-ES"), true);
        var abilityCards = Model.Abilities.Select(ability => new
            {
                Name = ability.Name,
                Description = ability.Description,
                Category = "ability",
                Appears = ability.Appears,
                Symbol = ability.Name.AbilitySymbol(),
                Color = ability.Name.AbilityColor(),
                Owners = Model.Monsters
                    .Where(monster => monster.Ability.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                        .Contains(ability.Name, StringComparer.OrdinalIgnoreCase))
                    .Select(monster => monster.Name)
                    .ToList()
            });
        var spellCards = Model.SpellsOfTerror.Select(spell => new
            {
                Name = spell.Name,
                Description = spell.Description,
                Category = "spell",
                Appears = spell.Appears,
                Symbol = spell.Name.SpellSymbol(),
                Color = spell.Name.SpellColor(),
                Owners = Model.Monsters
                    .Where(monster => monster.SpellLinks.Any(link => link.SpellOfTerrorId == spell.Id))
                    .Select(monster => monster.Name)
                    .ToList()
            });
        // Unimos ambos tipos antes de ordenar para que el listado completo también quede alfabético.
        var archiveCards = abilityCards.Concat(spellCards).OrderBy(card => card.Name, spanishComparer).ToList();
        <div class="ability-category-filters" role="group" aria-label="Filtrar habilidades y hechizos">
            <button type="button" class="ability-filter-button active" data-archive-filter="all" aria-pressed="true">Todos</button>
            <button type="button" class="ability-filter-button" data-archive-filter="ability" aria-pressed="false">Habilidades</button>
            <button type="button" class="ability-filter-button" data-archive-filter="spell" aria-pressed="false">Hechizos</button>
        </div>
        <div class="ability-grid">
            @foreach (var card in archiveCards)
            {
                <article class="ability-card" data-archive-card="@card.Category">
                    <div class="ability-card-heading">
                        <h3><span class="ability-icon @(card.Category == "spell" ? "spell-icon" : "")" style="--ability-color: @card.Color" aria-hidden="true">@card.Symbol</span>@card.Name</h3>
                        <span class="ability-kind">@(card.Category == "spell" ? "Hechizo" : "Habilidad")</span>
                    </div>
                    <p class="ability-card-description">@card.Description</p>
                    <p class="ability-card-owners"><strong>Monstruos que poseen @(card.Category == "spell" ? "este hechizo" : "esta habilidad"):</strong> @(card.Owners.Count > 0 ? string.Join(" · ", card.Owners) : "Sin monstruos vinculados")</p>
                    <footer class="ability-card-expansion"><span>Expansión</span><strong>@card.Appears.DisplayName()</strong></footer>
                </article>
            }
        </div>
    }
</section>


