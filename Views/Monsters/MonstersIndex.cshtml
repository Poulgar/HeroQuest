@model HeroQuest.ViewModels.MonsterCatalogViewModel
@{
    ViewData["Title"] = "Monstruos";
    string ShortIndexName(string name, int limit = 25) => name.Length <= limit ? name : name[..(limit - 1)] + "…";
}

<section class="catalog-page page-shell">
    <div class="page-heading">
        <p class="eyebrow">EL BESTIARIO</p>
        <h1>Criaturas de la <em>mazmorra</em></h1>
        <p>Selecciona una criatura para consultar sus atributos y habilidades.</p>
    </div>

    @if (Model.Monsters.Count == 0)
    {
        <div class="empty-note"><span aria-hidden="true">⚜</span><p>Aún no hay criaturas en el bestiario.</p></div>
    }
    else
    {
        <div class="catalog-layout">
            <aside class="catalog-list" aria-label="Lista de monstruos">
                <p class="list-caption">ÍNDICE <span>@Model.Monsters.Count CRIATURAS</span></p>
                <div class="index-tools">
                    <label>Buscar <input class="index-search" type="search" placeholder="Nombre o habilidad…" /></label>
                    <label>Ordenar <select class="index-sort"><option value="name-asc">Alfabético</option><option value="name-desc">Alfabético inverso</option><option value="appears">Expansión</option></select></label>
                </div>
                <div class="catalog-scroll" data-index-list>
                @foreach (var monster in Model.Monsters)
                {
                    <a class="catalog-row @(Model.SelectedMonster?.Id == monster.Id ? "selected" : "")"
                       data-name="@(string.IsNullOrWhiteSpace(monster.Name) ? monster.CharacterType : monster.Name)" data-search="@monster.Name @monster.CharacterType @monster.Ability" data-appears="@monster.Appears.DisplayName()" data-id="@monster.Id"
                       asp-controller="Monsters" asp-action="Index" asp-route-id="@monster.Id" aria-current="@(Model.SelectedMonster?.Id == monster.Id ? "page" : null)">
                        <span class="row-initial monster-initial">@((!string.IsNullOrEmpty(monster.Name) ? monster.Name[..1] : (!string.IsNullOrEmpty(monster.CharacterType) ? monster.CharacterType[..1] : "?")).ToUpperInvariant())</span>
                        <span class="row-main"><strong>@ShortIndexName(string.IsNullOrEmpty(monster.Name) ? monster.CharacterType : monster.Name)</strong><small>@monster.Hp HP • @monster.DicesAttack ataque</small></span>
                        <span class="row-chevron" aria-hidden="true">›</span>
                    </a>
                }
                </div>
            </aside>

            @if (Model.SelectedMonster is { } monsterDetail)
            {
                <article class="detail-card monster-detail-card">
                    <div class="detail-art monster-art">
                        <img src="~/images/heroquest/monster-portrait.svg" alt="Ilustración de @monsterDetail.CharacterType" />
                        <span class="portrait-ribbon">REGISTRO DEL BESTIARIO</span>
                    </div>
                    <div class="detail-content">
                        <p class="eyebrow">@monsterDetail.TypeMonsterRol.DisplayName() • N.º @monsterDetail.Id</p>
                        <h2>@(string.IsNullOrEmpty(monsterDetail.Name) ? monsterDetail.CharacterType : monsterDetail.Name)</h2>
                        <p class="detail-subtitle">Criatura catalogada en las profundidades</p>
                        @if (!string.IsNullOrWhiteSpace(monsterDetail.Description))
                        {
                            <p class="detail-description">@monsterDetail.Description</p>
                        }
                        <div class="stat-grid">
                            <div><span>Vida</span><strong>@monsterDetail.HpCurrent / @monsterDetail.Hp</strong></div>
                            <div><span>Mente</span><strong>@monsterDetail.Mind</strong></div>
                            <div><span>Ataque</span><strong>@monsterDetail.DicesAttack dados</strong></div>
                            <div><span>Defensa</span><strong>@monsterDetail.DicesDefend dados</strong></div>
                            <div><span>Movimiento</span><strong>@monsterDetail.Movement</strong></div>
                            <div><span>Movimiento Máximo</span><strong>@monsterDetail.MaxMovement</strong></div>
                            <div><span>Cuerpo</span><strong>@monsterDetail.Body</strong></div>
                            <div><span>Clasificación</span><strong>@monsterDetail.TypeMonsterRol.DisplayName()</strong></div>
                            <div><span>Expansión</span><strong>@monsterDetail.Appears.DisplayName()</strong></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(monsterDetail.Ability) &&
                             !monsterDetail.Ability.Contains("http", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="detail-divider"><span>HABILIDADES</span></div>
                            <p class="detail-description">@monsterDetail.Ability</p>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="ability-archive page-shell">
    <div class="ability-heading">
        <p class="eyebrow">SABER DEL BESTIARIO</p>
        <h2>Habilidades de monstruo</h2>
        <p>Reglas y rasgos especiales registrados en el compendio.</p>
    </div>
    @if (Model.Abilities.Count == 0)
    {
        <div class="empty-note"><p>Aún no hay habilidades importadas.</p></div>
    }
    else
    {
        <div class="ability-grid">
            @foreach (var ability in Model.Abilities)
            {
                <article class="ability-card">
                    <div class="ability-card-heading"><h3>@ability.Name</h3><span>@ability.Appears.DisplayName()</span></div>
                    <p>@ability.Description</p>
                </article>
            }
        </div>
    }
</section>

