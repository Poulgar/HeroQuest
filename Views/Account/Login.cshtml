@model HeroQuest.Models.LoginViewModel
@{
    ViewData["Title"] = "La guardia del Compendio";
}
<section class="account-panel page-shell">
    <p class="eyebrow">ANTE LAS PUERTAS DEL REINO</p>
    <h1>La guardia del <em>Compendio</em></h1>
    <blockquote class="login-verse" data-poem-key="gate">
        <span data-login-poem-title>La guardia del Compendio</span>
        <p data-login-poem-text>«Alto, viajero, di tu nombre sin temor; y revela tu código para cruzar el umbral.»</p>
    </blockquote>
    <p>El guardián espera el nombre con que recorres estas páginas y el código que abre sus cerraduras.</p>
    <aside class="login-test-accounts"><strong>Credenciales de prueba</strong><span>Aventurero: <code>user</code> / <code>user123</code></span><span>Maestro de Juego: <code>admin</code> / <code>admin123</code></span></aside>
    <form asp-action="Login" method="post" class="study-form">
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        <label asp-for="Username"></label><input asp-for="Username" autocomplete="username" placeholder="user o admin" />
        <span asp-validation-for="Username" class="form-error"></span>
        <label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" placeholder="Pronuncia tu código" />
        <span asp-validation-for="Password" class="form-error"></span>
        <button class="fantasy-button fantasy-button-primary" type="submit">Cruzar el umbral</button>
    </form>
</section>
