@model HeroQuest.Models.CatalogEditViewModel
@{ ViewData["Title"] = Model.Id is null ? "Nueva ficha · Biblioteca" : "Consultar ficha · Biblioteca"; }
<section class="admin-page page-shell">
    <p class="eyebrow">BIBLIOTECA DEL REINO · @(Model.Id is null ? "NUEVA FICHA" : $"FICHA N.º {Model.Id}")</p><h1>@(Model.Id is null ? "Añadir al" : "Consultar en la") <em>Biblioteca</em></h1>
    <form asp-action="Save" method="post" class="study-form admin-edit-form">
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        <input asp-for="Type" type="hidden"/><input asp-for="Id" type="hidden"/>
        @if (Model.Type == "poems")
        {
            <label asp-for="Key">Clave breve (por ejemplo: saludo-del-rey)</label><input asp-for="Key"/><span asp-validation-for="Key" class="form-error"></span>
            <label asp-for="Name">Título del verso</label><input asp-for="Name"/><span asp-validation-for="Name" class="form-error"></span>
            <label asp-for="Description">Texto del poema o leyenda</label><textarea asp-for="Description" rows="6"></textarea>
        }
        else
        {
            <label asp-for="Name">Nombre</label><input asp-for="Name"/><span asp-validation-for="Name" class="form-error"></span>
            <label asp-for="Description">Descripción / lore</label><textarea asp-for="Description" rows="4"></textarea>
            <label asp-for="AppearsOptions">Expansiones (puedes elegir varias)</label>
            <select asp-for="AppearsOptions" multiple size="7">
                @foreach (string option in ViewBag.AppearanceOptions) { <option value="@option">@option</option> }
            </select>
        }
        @if (Model.Type == "heroes")
        {
            <label asp-for="CharacterTypeClass">Clase</label><select asp-for="CharacterTypeClass"><option value="">Elige una clase</option>@foreach (string option in ViewBag.HeroClassOptions) { <option value="@option">@option</option> }</select>
            <div class="edit-stats"><label>Vida<input asp-for="Hp" type="number" min="0"/></label><label>Dados de mente<input asp-for="DicesMind" type="number" min="0"/></label><label>Dados de ataque<input asp-for="DicesAttack" type="number" min="0"/></label><label>Dados de defensa<input asp-for="DicesDefend" type="number" min="0"/></label><label>Movimiento (dados rojos)<input asp-for="DicesRedMovement" type="number" min="0"/></label></div>
            <label asp-for="Player">Jugador</label><input asp-for="Player"/><label asp-for="Weapon">Arma</label><input asp-for="Weapon"/><label asp-for="Armor">Armadura</label><input asp-for="Armor"/>
            <label asp-for="AbilityOptions">Habilidades y hechizos (puedes elegir varios)</label><select asp-for="AbilityOptions" multiple size="6">@foreach (string option in ViewBag.AbilityCatalogOptions) { <option value="@option">@option</option> }</select>
            <label asp-for="Items">Objetos</label><input asp-for="Items"/><label asp-for="Gold">Oro</label><input asp-for="Gold" type="number"/><label asp-for="QuestsCompleted">Misiones completadas</label><input asp-for="QuestsCompleted" type="number"/>
        }
        else if (Model.Type == "monsters")
        {
            <label asp-for="Faction">Facción</label><select asp-for="Faction"><option value="">Elige una facción</option>@foreach (string option in ViewBag.FactionOptions) { <option value="@option">@option</option> }</select>
            <label asp-for="AbilityOptions">Habilidades y hechizos (puedes elegir varios)</label><select asp-for="AbilityOptions" multiple size="6">@foreach (string option in ViewBag.AbilityCatalogOptions) { <option value="@option">@option</option> }</select>
            <div class="edit-stats"><label>Vida<input asp-for="Hp" type="number" min="0"/></label><label>Dados de mente<input asp-for="DicesMind" type="number" min="0"/></label><label>Dados de ataque<input asp-for="DicesAttack" type="number" min="0"/></label><label>Dados de defensa<input asp-for="DicesDefend" type="number" min="0"/></label><label>Movimiento máximo<input asp-for="MaxMovement" type="number" min="0"/></label></div>
        }
        else if (Model.Type == "equipment")
        {
            <label asp-for="Category">Categoría</label><select asp-for="Category"><option value="Equipment">Equipo</option><option value="Artifact">Artefacto</option></select>
            <label asp-for="ItemType">Tipo</label><select asp-for="ItemType"><option value="">Elige un tipo</option>@foreach (string option in ViewBag.EquipmentTypeOptions) { <option value="@option">@option</option> }</select>
            <label asp-for="Price">Precio en monedas de oro</label><input asp-for="Price" type="number" min="0"/><label asp-for="Weight">Peso</label><input asp-for="Weight"/>
        }
        else if (Model.Type == "miscellanea")
        {
            <label asp-for="Price">Precio en monedas de oro</label><input asp-for="Price" type="number" min="0"/>
        }
        else if (Model.Type == "spells")
        {
            <label asp-for="SpellType">Tipo de hechizo</label><select asp-for="SpellType"><option value="">Elige un tipo</option>@foreach (string option in ViewBag.SpellTypeOptions) { <option value="@option">@option</option> }</select>
        }
        @if (Model.Id is not null) { <label class="archive-toggle"><input asp-for="IsArchived"/> Archivado (desmarcar para restaurarlo)</label> }
        <div class="admin-actions"><button class="fantasy-button small library-action-save" type="submit">Guardar cambios</button><a class="fantasy-button small" asp-action="Index" asp-route-type="@Model.Type">Volver al estante</a></div>
    </form>
</section>
