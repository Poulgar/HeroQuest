@model HeroQuest.Models.CatalogListViewModel
@{ ViewData["Title"] = "Biblioteca · " + Model.Title; }
<section class="admin-page page-shell">
    <p class="eyebrow">BIBLIOTECA DEL REINO</p>
    <h1>Biblioteca de <em>@Model.Title</em></h1>
    <p>Consulta las fichas que aún viajan con el Compendio y añade aquí nuevos relatos.</p>
    <div class="library-actions">
        <a class="fantasy-button fantasy-button-primary" asp-action="Edit" asp-route-type="@Model.Type">Inscribir una nueva ficha</a>
        <a class="fantasy-button" asp-action="Archive" asp-route-type="@Model.Type">Consultar en el Archivo</a>
    </div>
    <div class="admin-list" role="list">
        @if (Model.Items.Count == 0)
        {
            <p class="library-empty">Aún no hay fichas en este estante.</p>
        }
        @foreach (var item in Model.Items)
        {
            <article class="admin-row">
                <div><strong>@item.Name</strong><small>#@item.Id · @item.Details</small></div>
                <div class="admin-actions">
                    <a class="fantasy-button small" asp-action="Edit" asp-route-type="@Model.Type" asp-route-id="@item.Id">Consultar ficha</a>
                    <form asp-action="Archive" method="post"><input type="hidden" name="type" value="@Model.Type"/><input type="hidden" name="id" value="@item.Id"/><button class="fantasy-button small" type="submit">Guardar en el Archivo</button></form>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('¿Borrar definitivamente esta ficha? Esta acción no se puede deshacer.');"><input type="hidden" name="type" value="@Model.Type"/><input type="hidden" name="id" value="@item.Id"/><button class="fantasy-button small danger" type="submit">Destruir ficha</button></form>
                </div>
            </article>
        }
    </div>
</section>
