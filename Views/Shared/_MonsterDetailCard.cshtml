@model HeroQuest.ViewModels.MonsterDetailCardViewModel
@{
    var monster = Model.Monster;
    var abilityNames = monster.Ability.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
}
<article class="detail-card monster-detail-card">
    <div class="detail-art monster-art">
        <img src="~/images/heroquest/monster-portrait.svg" alt="Ilustración de @monster.Name" />
        <span class="portrait-ribbon">REGISTRO DEL BESTIARIO</span>
    </div>
    <div class="detail-content">
        <p class="eyebrow">BESTIARIO • N.º @monster.Id</p>
        <h2>@monster.Name</h2>
        <p class="detail-description"><strong>Descripción:</strong> @monster.Description</p>
        <div class="stat-grid">
            <div><span>Vida</span><strong>@monster.Hp</strong></div>
            <div><span>Movimiento máximo</span><strong>@monster.MaxMovement</strong></div>
            <div><span>Mente</span><strong>@monster.DicesMind dados</strong></div>
            <div><span>Ataque</span><strong>@monster.DicesAttack dados</strong></div>
            <div><span>Defensa</span><strong>@monster.DicesDefend dados</strong></div>
            <div><span>Facción</span><strong><button type="button" class="faction-token lore-trigger hover-tooltip" style="--faction-color: @monster.Faction.FactionColor()" data-tooltip="@monster.Faction" data-lore-title="Facción: @monster.Faction" data-full-description="@monster.Faction.FactionLore()" aria-label="Consultar lore de la facción @monster.Faction">@monster.Faction.FactionSymbol()</button></strong></div>
        </div>
        <div class="detail-divider"><span>HABILIDADES Y HECHIZOS</span></div>
        <div class="monster-skill-icons" aria-label="Habilidades y hechizos de @monster.Name">
            @foreach (var abilityName in abilityNames)
            {
                var spellLink = monster.SpellLinks.FirstOrDefault(link => string.Equals(link.SpellOfTerror.Name, abilityName, StringComparison.OrdinalIgnoreCase));
                if (spellLink is not null)
                {
                    var tooltipText = $"{abilityName}: {spellLink.SpellOfTerror.Description.ShortEffect(abilityName)}";
                    <button type="button" class="ability-icon spell-icon skill-trigger hover-tooltip" style="--ability-color: @abilityName.SpellColor()" data-tooltip="@tooltipText" data-full-description="@spellLink.SpellOfTerror.Description" data-skill-name="@abilityName" aria-label="Hechizo: @abilityName">@abilityName.SpellSymbol()</button>
                }
                else
                {
                    var ability = Model.Abilities.FirstOrDefault(entry => string.Equals(entry.Name, abilityName, StringComparison.OrdinalIgnoreCase));
                    var description = ability?.Description ?? abilityName;
                    var tooltipText = $"{abilityName}: {description.ShortEffect(abilityName)}";
                    <button type="button" class="ability-icon ability-square skill-trigger hover-tooltip" style="--ability-color: @abilityName.AbilityColor()" data-tooltip="@tooltipText" data-full-description="@description" data-skill-name="@abilityName" aria-label="Habilidad: @abilityName">@abilityName.AbilitySymbol()</button>
                }
            }
        </div>
    </div>
    <footer class="detail-expansion-footer"><span>Expansión</span><strong>@monster.Appears.DisplayName()</strong></footer>
</article>
