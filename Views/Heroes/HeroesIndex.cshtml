@model HeroQuest.ViewModels.HeroCatalogViewModel
@{
    ViewData["Title"] = "Héroes";
}

<section class="catalog-page page-shell">
    <div class="page-heading">
        <p class="eyebrow">EL GRUPO DE AVENTUREROS</p>
        <h1>Registro de <em>héroes</em></h1>
        <p>Selecciona un nombre para consultar su ficha.</p>
    </div>

    @if (Model.Heroes.Count == 0)
    {
        <div class="empty-note"><span aria-hidden="true">⚜</span><p>Aún no hay héroes en el registro.</p></div>
    }
    else
    {
        <div class="catalog-layout">
            <aside class="catalog-list" aria-label="Lista de héroes">
                <p class="list-caption">ÍNDICE <span>@Model.Heroes.Count PERSONAJES</span></p>
                @foreach (var hero in Model.Heroes)
                {
                    <a class="catalog-row @(Model.SelectedHero?.Id == hero.Id ? "selected" : "")"
                       asp-controller="Heroes" asp-action="Index" asp-route-id="@hero.Id" aria-current="@(Model.SelectedHero?.Id == hero.Id ? "page" : null)">
                        <span class="row-initial">@((hero.Name.Length > 0 ? hero.Name[..1] : "?").ToUpperInvariant())</span>
                        <span class="row-main"><strong>@hero.Name</strong><small>@hero.CharacterType • @hero.Hp HP</small></span>
                        <span class="row-chevron" aria-hidden="true">›</span>
                    </a>
                }
            </aside>

            @if (Model.SelectedHero is { } heroDetail)
            {
                <article class="detail-card" style="min-height: 100%;">
                    <div class="detail-art hero-art">
                        <img src="~/images/heroquest/hero-portrait.svg" alt="Ilustración de @heroDetail.Name" />
                        <span class="portrait-ribbon">FICHA DEL AVENTURERO</span>
                    </div>
                    <div class="detail-content">
                        <p class="eyebrow">@heroDetail.CharacterType • N.º @heroDetail.Id</p>
                        <h2>@heroDetail.Name</h2>
                        <p class="detail-subtitle">@(string.IsNullOrWhiteSpace(heroDetail.Player) ? "Sin jugador asignado" : $"Jugador: {heroDetail.Player}")</p>
                        @if (!string.IsNullOrWhiteSpace(heroDetail.Description))
                        {
                            <p class="detail-description">@heroDetail.Description</p>
                        }
                        <div class="stat-grid">
                            <div><span>Vida</span><strong>@heroDetail.HpCurrent / @heroDetail.Hp</strong></div>
                            <div><span>Mente</span><strong>@heroDetail.Mind</strong></div>
                            <div><span>Ataque</span><strong>@heroDetail.DicesAttack dados</strong></div>
                            <div><span>Defensa</span><strong>@heroDetail.DicesDefend dados</strong></div>
                            <div><span>Movimiento</span><strong>@heroDetail.DicesMovement dados</strong></div>
                            <div><span>Oro</span><strong>@heroDetail.Gold</strong></div>
                        </div>
                        <div class="detail-divider"><span>PERTENENCIAS Y HAZAÑAS</span></div>
                        <dl class="detail-facts">
                            <div><dt>Arma</dt><dd>@(string.IsNullOrWhiteSpace(heroDetail.Weapon) ? "-" : heroDetail.Weapon)</dd></div>
                            <div><dt>Armadura</dt><dd>@(heroDetail.Armor ?? "-")</dd></div>
                            <div><dt>Hechizos</dt><dd>@(heroDetail.Spells ?? "-")</dd></div>
                            <div><dt>Objetos</dt><dd>@(heroDetail.Items ?? "-")</dd></div>
                            <div><dt>Misiones completadas</dt><dd>@heroDetail.QuestsCompleted</dd></div>
                            <div><dt>Expansión</dt><dd>@heroDetail.Appears.DisplayName()</dd></div>
                        </dl>
                    </div>
                </article>
            }
        </div>
    }
</section>
