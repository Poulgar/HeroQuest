@model HeroQuest.ViewModels.HeroCatalogViewModel
@{
    ViewData["Title"] = "Héroes";
    string ShortIndexName(string name, int limit = 25) => name.Length <= limit ? name : name[..(limit - 1)] + "…";
}

<section class="catalog-page page-shell">
    <div class="page-heading">
        <p class="eyebrow">EL GRUPO DE AVENTUREROS</p>
        <h1>Registro de <em>héroes</em></h1>
        <p>Selecciona un nombre para consultar su ficha.</p>
    </div>

    @if (Model.Heroes.Count == 0)
    {
        <div class="empty-note"><span aria-hidden="true">⚜</span><p>Aún no hay héroes en el registro.</p></div>
    }
    else
    {
        <div class="catalog-layout">
            <aside class="catalog-list" aria-label="Lista de héroes">
                <p class="list-caption">ÍNDICE <span>@Model.Heroes.Count PERSONAJES</span></p>
                <div class="index-tools">
                    <label>Buscar <input class="index-search" type="search" placeholder="Nombre o jugador…" /></label>
                    <label>Ordenar <select class="index-sort"><option value="name-asc">A-Z</option><option value="name-desc">Z-A</option><option value="appears">Expansión</option></select></label>
                </div>
                <div class="catalog-scroll" data-index-list>
                @foreach (var hero in Model.Heroes)
                {
                    <a class="catalog-row @(Model.SelectedHero?.Id == hero.Id ? "selected" : "")"
                       data-select-record="@hero.Id" data-name="@hero.Name" data-search="@hero.Name @hero.Player @hero.CharacterType" data-appears="@hero.Appears.DisplayName()" data-id="@hero.Id"
                       asp-controller="Heroes" asp-action="Index" asp-route-id="@hero.Id" aria-current="@(Model.SelectedHero?.Id == hero.Id ? "page" : null)">
                        <span class="index-symbol" aria-hidden="true">
                            <svg viewBox="0 0 32 32"><path d="M5 8l6 4 5-8 5 8 6-4-2 14H7L5 8zM8 26h16M12 17h.1M20 17h.1" /></svg>
                        </span>
                        <span class="row-main">
                            <strong>@ShortIndexName(string.IsNullOrWhiteSpace(hero.CharacterType) ? hero.Name : hero.CharacterType)</strong>
                            <small class="row-stats">@hero.Hp HP · D@(hero.Mind) MND · D@(hero.DicesAttack) ATK · D@(hero.DicesDefend) DFC</small>
                        </span>
                        <span class="row-chevron" aria-hidden="true">›</span>
                    </a>
                }
                </div>
            </aside>

            <div class="detail-host" data-detail-host>
                @if (Model.SelectedHero is { } heroDetail)
                {
                    @await Html.PartialAsync("~/Views/Shared/_HeroDetailCard.cshtml", heroDetail)
                }
            </div>
        </div>

        @foreach (var hero in Model.Heroes)
        {
            <template data-detail-template="@hero.Id">@await Html.PartialAsync("~/Views/Shared/_HeroDetailCard.cshtml", hero)</template>
        }
    }
</section>


